# customerB.env
TENANT=customerB

# ======================
# Gateway (publica)
# ======================
GATEWAY_MQTT_USER=gateway
GATEWAY_MQTT_PASS=gateway

# ======================
# Telegraf (consume)
# ======================
TELEGRAF_MQTT_USER=ingest_customerB
TELEGRAF_MQTT_PASS=123
TELEGRAF_MQTT_SERVER=tcp://mosquitto:1883

# ======================
# InfluxDB
# ======================
INFLUX_URL=http://influxdb:8086
INFLUX_ORG=acme
INFLUX_BUCKET=deployment_customerB
INFLUX_TOKEN_DEPLOYMENT=CAMBIA_ESTE_TOKEN_PARA_CUSTOMERB


# ======================
# MSSQL
# ======================
ACCEPT_EULA=Y
MSSQL_PID=Developer
MSSQL_SA_PASSWORD=StrongPassw0rd!
MSSQL_HOST=sqlserver
MSSQL_DB=industry4_customerB
MSSQL_USER=sa
MSSQL_PASSWORD=StrongPassw0rd!
MSSQL_DRIVER=ODBC Driver 18 for SQL Server


# ======================
# EDGE / MQTT
# ======================
MQTT_HOST=mosquitto_customerB
MQTT_PORT=1883
MQTT_USER=writer
MQTT_PASSWORD=writer

MQTT_TOPIC=customerB/#


# ======================
# JWT
# ======================
JWT_ISSUER=wire-integral


# ======================
# REDIS local
# ======================
REDIS_HOST=redis
REDIS_PORT=6379


# ======================
# Redis Central (Django API)
# ======================
CENTRAL_REDIS_HOST=redis-central
CENTRAL_REDIS_PORT=6379
# CENTRAL_REDIS_PASSWORD=

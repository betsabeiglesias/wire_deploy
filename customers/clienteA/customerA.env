# MSSQL
ACCEPT_EULA=Y
MSSQL_PID=Developer
MSSQL_SA_PASSWORD=StrongPassw0rd!
MSSQL_HOST=sqlserver
MSSQL_DB=textil
MSSQL_USER=sa
MSSQL_PASSWORD=StrongPassw0rd!

# customerA.env
TENANT=customerA
NETWORK_NAME=wire-net 

# # Para el Gateway (publica)
GATEWAY_MQTT_USER=gateway
GATEWAY_MQTT_PASS=gateway

# Para Telegraf (consume)
TELEGRAF_MQTT_USER=ingest_customerA
TELEGRAF_MQTT_PASS=123
TELEGRAF_MQTT_SERVER=tcp://mosquitto:1883


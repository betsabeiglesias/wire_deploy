# EDGE
MQTT_HOST=mosquitto_customerA
MQTT_PORT=1883
MQTT_USER=writer
MQTT_PASSWORD=writer
MQTT_TOPIC=customerA/#

WRITER_ID=writer-customerA


# JWT
JWT_ISSUER=wire-integral


# REDIS
REDIS_HOST=redis
REDIS_PORT=6379


# ✅ Redis Central (servidor de tu Django-API)
CENTRAL_REDIS_HOST=redis-central
CENTRAL_REDIS_PORT=6379
# CENTRAL_REDIS_PASSWORD=  # Opcional, si tu Redis central tiene password

# --- DATABASE CONFIG (Interna para Django)
POSTGRES_DB=industry4_v2
POSTGRES_USER=django
POSTGRES_PASSWORD=django1234
POSTGRES_HOST=postgres
POSTGRES_PORT=5432


# Endpoint para generar yaml desde edge
CENTRAL_HOST=http://wire-deploy-django-api:8000
CONFIG_SYNC_INTERVAL=30
EDGE_API_KEY=dev-secret
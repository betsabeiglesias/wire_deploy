{
  "$id": "https://yourdomain.local/contracts/v1.tag.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CDC Tag v1",
  "type": "object",
  "required": [
    "schema", "equipment_id", "variable",
    "value", "datatype", "timestamp",
    "quality", "source"
  ],
  "properties": {
    "schema": { "const": "v1.tag" },

    "equipment_id": {
      "type": "string",
      "minLength": 3,
      "description": "Jerarquía ISA-95: Site/Area/Line/Cell/Equipment"
    },

    "variable": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_./-]+$",
      "description": "Nombre corto estandarizado (p.ej. pressure, cmd_start)"
    },

    "value": {
      "description": "Valor actual de la variable (el tipo real lo define 'datatype')"
    },

    "datatype": {
      "type": "string",
      "enum": [
        "Boolean","Int16","Int32","UInt16","UInt32",
        "Float","Double","String","DateTime","Char"
      ]
    },

    "unit": {
      "type": "string",
      "description": "Unidad UCUM/SI si aplica (bar, °C, m3/h, %)"
    },

    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "UTC ISO-8601, p.ej. 2025-10-16T10:32:12.345Z"
    },

    "quality": {
      "type": "string",
      "enum": ["Good","Uncertain","Bad"]
    },

    "source": {
      "type": "object",
      "required": ["protocol","address"],
      "properties": {
        "protocol": { "type": "string" },         
        "endpoint": { "type": "string" },         
        "address":  { "type": "string" }        
      },
      "additionalProperties": true
    },

    "attrs": {
      "type": "object",
      "description": "Metadatos opcionales (eng_min, eng_max, role, packml, etc.)",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

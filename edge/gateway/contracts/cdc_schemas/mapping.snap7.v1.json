{
  "$id": "mapping.snap7.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Snap7 Mapping v1 (with optional connection/polling)",
  "type": "object",
  "required": ["driver", "equipment_id", "items"],
  "properties": {
    "driver": { "const": "snap7" },
    "equipment_id": { "type": "string", "minLength": 1 },

    "connection": {
      "type": "object",
      "required": ["ip", "rack", "slot"],
      "properties": {
        "ip":         { "type": "string", "minLength": 1 },
        "rack":       { "type": "integer", "minimum": 0 },
        "slot":       { "type": "integer", "minimum": 0 },
        "timeout_ms": { "type": "integer", "minimum": 0 },
        "pdu_size":   { "type": "integer", "minimum": 240, "maximum": 960 }
      },
      "additionalProperties": false
    },

    "polling": {
      "type": "object",
      "properties": {
        "interval_ms": { "type": "integer", "minimum": 10 }
      },
      "additionalProperties": false
    },

    "on_change_only": { "type": "boolean" },
    "quality_on_bad": { "enum": ["drop", "last", "null"] },
    "deadband": {
      "type": "object",
      "properties": {
        "type":  { "enum": ["none", "absolute", "percent"] },
        "value": { "type": "number" }
      },
      "additionalProperties": false
    },

    "items": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["address","datatype"],
        "properties": {
          "name":     { "type": "string" },
          "variable": { "type": "string", "pattern": "^[a-zA-Z0-9_./-]+$" },
          "address":  { "type": "string", "minLength": 1 },
          "datatype": { "type": "string", "enum": ["Boolean","Int16","Int32","UInt16","UInt32","Float","Double","String","Char"] },
          "unit":     { "type": "string" },
          "scale":    { "type": "number" },
          "offset":   { "type": "number" },
          "attrs":    { "type": "object" }
        },
        "additionalProperties": true
      }
    },


    "ip":         { "type": "string" },
    "rack":       { "type": "integer" },
    "slot":       { "type": "integer" },
    "timeout_ms": { "type": "integer" },
    "pdu_size":   { "type": "integer" },
    "mode":       { "type": "string" },
    "poll_ms":    { "type": "integer" }
  },
  "additionalProperties": true
}
